// Copy to Secrets.xcconfig (ignored by git) and fill in. Never commit the real file.
// DEVELOPMENT_TEAM: your Apple team ID (Xcode > Settings > Accounts).
// META_APP_ID / CLIENT_TOKEN: from your project in the Meta Wearables Developer Center.
DEVELOPMENT_TEAM = ABCDE12345
ARGUS_BUNDLE_ID = com.yourname.arguseye
META_APP_ID = 0000000000000000
CLIENT_TOKEN = your-client-token
