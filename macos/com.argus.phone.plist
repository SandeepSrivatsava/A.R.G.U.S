<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.argus.phone</string>
  <key>ProgramArguments</key><array><string>@PYTHON@</string><string>-I</string><string>-m</string><string>argus</string><string>phone</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOGS@/phone.out.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/phone.err.log</string>
</dict>
</plist>
