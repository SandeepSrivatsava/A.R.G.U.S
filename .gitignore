# Secrets never belong in this repo (setup.sh keeps them in ~/.argus/secrets.env, mode 600)
.env
.env.*
*.local
*.key
*.pem
phone_token
voiceprint.npy

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Speech models and audio are downloaded / produced at runtime, never committed
models/
*.onnx
*.wav

# macOS / editors
.DS_Store
.vscode/
.idea/

# Test coverage data (scripts/coverage.sh)
.coverage
.coverage.*
htmlcov/
